NODE_ENV=development
LOG_LEVEL=info

MCP_SERVER_NAME=engineering-mcp
MCP_SERVER_VERSION=0.1.0

MCP_READ_ONLY=true

MCP_ALLOW_JIRA_WRITE=false
MCP_ALLOW_GITHUB_WRITE=false
MCP_ALLOW_CONFLUENCE_WRITE=false

# Optional: absolute path to platform projects/ directory
# PROJECTS_DIR=

# Optional: absolute path to platform policies/ directory
# POLICIES_DIR=

# Jira Cloud (optional — server starts without these; tools error until set)
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_REQUEST_TIMEOUT_MS=10000

# GitHub (optional — server starts without these; tools error until set)
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_REQUEST_TIMEOUT_MS=10000
GITHUB_MAX_FILE_BYTES=102400

# Confluence Cloud (optional — server starts without these; tools error until set)
CONFLUENCE_BASE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_REQUEST_TIMEOUT_MS=10000
CONFLUENCE_MAX_PAGE_SIZE_BYTES=204800

# Engineering Intelligence thresholds (deterministic risk rules)
PR_STALE_HOURS=48
PR_HIGH_RISK_HOURS=72
PR_LARGE_CHANGES=500
PR_REVIEW_WAITING_HOURS=24
ENGINEERING_STALE_DAYS=7

# Optional integration test gates (default false)
# JIRA_INTEGRATION_TEST=false
# GITHUB_INTEGRATION_TEST=false
# CONFLUENCE_INTEGRATION_TEST=false
