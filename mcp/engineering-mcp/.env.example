NODE_ENV=development
LOG_LEVEL=info

MCP_SERVER_NAME=engineering-mcp
MCP_SERVER_VERSION=0.1.0

MCP_READ_ONLY=true

MCP_ALLOW_JIRA_WRITE=false
MCP_ALLOW_GITHUB_WRITE=false
MCP_ALLOW_CONFLUENCE_WRITE=false

# Optional: absolute path to platform projects/ directory
# PROJECTS_DIR=

# Future integrations (do not put real credentials here)
# JIRA_BASE_URL=
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# GITHUB_TOKEN=
# GITHUB_API_URL=https://api.github.com
# CONFLUENCE_BASE_URL=
# CONFLUENCE_EMAIL=
# CONFLUENCE_API_TOKEN=
